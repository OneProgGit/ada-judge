#let lang = "ru"
#let tr = (
  en: (
    page: "1 of 1",
  ),
  ru: (
    page: "Страница 1 из 1",
  )
)
#let t(key) = tr.at(lang).at(key)
#let template(title, subtitle: none, body) = {
  set page(
    paper: "a5",
    margin: (x: 20pt, top: 130pt, bottom: 50pt),
    header: align(center)[
      #line(length: 100%)
      == #title
      #subtitle
      #line(length: 100%)
    ],
    footer: context align(center)[
      #line(length: 100%)
      #counter(page).display(t("page"), both: true)
    ],
  )
  set par(justify: true, linebreaks: "optimized")
  body
}
#let problem(title, contents) = {
  [
    = #title
    #contents $square.filled$
  ]
}

#template([Разбор тестового контеста],
  [
    #problem("A. Сумма чисел I",
      [
        Ответ — это $n + m$: достаточно считать два числа, сложить их и вывести результат. При ограничении $(1 <= n, m <= 1000)$ сумма не превосходит $2000$ и помещается в любой целочисленный тип, поэтому переполнение невозможно. Время работы решения — $O(1)$.
      ]
    )

    #pagebreak()

    #problem("B. Сумма чисел II",
      [
        Решение совпадает с решением задачи A. Подгруппы различаются только ограничениями: в первой $1 <= n, m <= 500$, во второй — до $1000$. Алгоритм от этого не меняется, поэтому отдельный код для первой подгруппы не требуется: корректная программа проходит обе подгруппы и получает 100 баллов.
      ]
    )

    #pagebreak()

    #problem("C. Сумма чисел III",
      [
        Ответ, как и в задачах A и B, — это $n + m$. Полный балл за подгруппу 1 начисляется при прохождении всех её тестов, которые включают в себя и тесты из условия. Иных особенностей задача не имеет.
      ]
    )

    #pagebreak()

    #problem("D. Сумма чисел IV",
      [
        Алгоритм тот же: ответ — это $n + m$. Особенность задачи — система оценки со слиянием подгрупп: для каждой подгруппы отдельно берётся лучший результат среди всех посылок, а баллы за задачу равны сумме этих максимумов. Так, посылка, прошедшая только подгруппу 1, и другая посылка, прошедшая только подгруппу 2, вместе приносят полные 100 баллов. Верное решение проходит все тесты обеих подгрупп и получает 100 баллов уже одной посылкой.
      ]
    )

    #pagebreak()

    #problem("E. Сумма чисел V",
      [
        Ответ — это $n + m$. Отличие от задач A--D состоит в системе оценки: два теста помимо тестов из условия оцениваются независимо, по 50 баллов каждый, а не как единая подгруппа. На решение это не влияет: частичного решения у задачи нет, она либо решается полностью, либо не решается.
      ]
    )

    #pagebreak()

    #problem("F. Угадай число",
      [
        Применяется двоичный поиск. Храним границы отрезка возможных значений $["lo", "hi"]$, изначально $"lo" = 1$, $"hi" = t$. На каждом шаге делаем запрос $x = floor(("lo" + "hi") / 2)$:
        - при ответе `=` число угадано, программу требуется немедленно завершить;
        - при ответе `<` загаданное число меньше $x$, отрезок сужается до $["lo", x - 1]$;
        - при ответе `>` отрезок сужается до $[x + 1, "hi"]$.

        Длина отрезка при каждом запросе сокращается не менее чем вдвое, поэтому число запросов не превышает $ceil(log_2 t)$; при $t <= 10000$ достаточно $14$ запросов. После каждого запроса необходимо сбрасывать буфер вывода, а после получения ответа `=` — немедленно завершать программу.
      ]
    )

    #pagebreak()

    #problem("G. Прибавь 1",
      [
        Задача с двойным запуском решается по частям. В первом запуске программа читает число $n$ и выводит $n + 1$. Во втором запуске на вход подаётся значение, выведенное первым запуском: его переносит система, поэтому создавать временные файлы не нужно. Требуется вывести $v - 1$, то есть восстановить исходное $n$.

        Основная сложность задачи — техническая, а не алгоритмическая: оба запуска должны работать только со стандартными потоками ввода-вывода, не выводить ничего лишнего и корректно завершаться.
      ]
    )
  ]
)
