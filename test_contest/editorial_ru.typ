#let lang = "ru"
#let tr = (
  en: (
    page: "1 of 1",
  ),
  ru: (
    page: "Страница 1 из 1",
  )
)
#let t(key) = tr.at(lang).at(key)
#let template(title, subtitle: none, body) = {
  set page(
    paper: "a5",
    margin: (x: 20pt, top: 130pt, bottom: 50pt),
    header: align(center)[
      #line(length: 100%)
      == #title
      #subtitle
      #line(length: 100%)
    ],
    footer: context align(center)[
      #line(length: 100%)
      #counter(page).display(t("page"), both: true)
    ],
  )
  set par(justify: true, linebreaks: "optimized")
  body
}
#let problem(title, contents) = {
  [
    = #title
    #contents $square.filled$
  ]
}

#template([Разбор тестового контеста], subtitle: [давным-давно],
  [
    #problem("A. Сумма чисел I",
      [
        Купец Аристарх Панкратьевич, при всей своей рачительности, задачу поставил нехитрую: заметим, что ответом служит попросту число $n + m$. Никакого иного рассуждения сия задача не требует -- считываем $n$ и $m$, складываем и выводим результат. При данных ограничениях $(1 <= n, m <= 1000)$ сумма заведомо помещается в любой целочисленный тип, переполнения можно не опасаться. Сложность решения -- $O(1)$.
      ]
    )

    #pagebreak()

    #problem("B. Сумма чисел II",
      [
        Решение то же самое, что и в задаче A: ответ есть $n + m$. Разбиение на подгруппы здесь имеет чисто дидактическую цель -- приучить читающего условие к мысли, что не всякая подгруппа усложняет алгоритм; порою она лишь сужает область входных данных, оставляя решение прежним. Оттого исправное решение первой подгруппы автоматически исправно и для второй, и написание отдельного кода для $(1 <= n, m <= 500)$ было бы пустою тратой чернил.
      ]
    )

    #pagebreak()

    #problem("C. Сумма чисел III",
      [
        Смотритель почтовой станции, при всей своей забывчивости, задачу задал ту же самую: ответ -- сумма $n + m$. Полный балл начисляется за прохождение всех тестов подгруппы 1, кои включают в себя и тесты из условия. Иных хитростей задача не таит -- достаточно чтения двух чисел и вывода их суммы.
      ]
    )

    #pagebreak()

    #problem("D. Сумма чисел IV",
      [
        Алгоритмически задача не отличается от предыдущих трёх: ответ есть $n + m$. Особого внимания заслуживает лишь система оценки со слиянием подгрупп: дабы получить баллы за подгруппу 2, решению надлежит пройти *все* тесты как подгруппы 1, так и подгруппы 2 -- иначе говоря, за подгруппу 2 баллы начисляются не сами по себе, а лишь в придачу к уже пройденной подгруппе 1. Поскольку решение единое для всех ограничений, верный код получает разом полную сотню баллов.
      ]
    )

    #pagebreak()

    #problem("E. Сумма чисел V",
      [
        И здесь ответ есть $n + m$, читаемый и выводимый без всяких ухищрений. Отличие от задач A--D состоит лишь в системе оценки: каждый из двух дополнительных тестов, помимо тестов из условия, оценивается по отдельности (по 50 баллов), а не единой подгруппой. На практике для решающего это различия не создаёт -- частичное решение здесь попросту невозможно, ибо задача решается целиком либо не решается вовсе.
      ]
    )

    #pagebreak()

    #problem("F. Угадай число",
      [
        Корнет Свен предлагает классическую задачу на *двоичный поиск*. Храните границы отрезка возможных значений $["lo", "hi"]$, изначально $"lo" = 1$, $"hi" = t$. На каждом шаге запрашивайте середину отрезка $x = floor(("lo" + "hi") / 2)$:
        - при ответе `=` -- число угадано, работу немедленно прекращаем;
        - при ответе `<` (загаданное меньше $x$) -- сужаем отрезок до $["lo", x - 1]$;
        - при ответе `>` -- сужаем отрезок до $[x + 1, "hi"]$.

        Отрезок при каждом запросе сокращается по меньшей мере вдвое, посему число запросов не превышает $ceil(log_2 t)$. При $t <= 10000$ довольно четырнадцати запросов -- этого с запасом хватает при любом разумном скрытом ограничении $k$. Необходимо не забывать о выводе (`flush`) после каждого запроса и о немедленном завершении программы по получении ответа `=`.
      ]
    )

    #pagebreak()

    #problem("G. Прибавь 1",
      [
        Задача разбирается по частям, соответствующим ролям писаря и чиновника. В первом запуске программа читает число $n$ и выводит $n + 1$ -- ничего сложнее сложения с единицей здесь не требуется. Во втором запуске программа получает на вход то самое число, что вывел первый запуск (жюри само переносит его со стандартного вывода первого запуска на стандартный ввод второго -- никаких временных файлов заводить не нужно), и обязана вывести $v - 1$, то есть исходное $n$.

        Главная трудность задачи -- не алгоритмическая, но организационная: убедиться, что оба запуска читают и пишут через стандартные потоки ввода-вывода в точности один раз, без лишних приглашений к вводу или отладочной печати, кои могли бы сбить проверяющую систему с толку.
      ]
    )
  ]
)
